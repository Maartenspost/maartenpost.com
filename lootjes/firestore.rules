rules_version = '2';
// Beveiligingsregels voor De Familie Leguit Lootjestrekmachine.
// Staat ingesteld in Firebase > Firestore Database > Regels (project leguit-lootjes).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOrganisator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['mail@maartenpost.com'];
    }
    function isPersoon(id) {
      return id in ['janwillem','gabrielle','willemijn','maarten','jesse','antoinette','sara','nine','jelle','janica'];
    }
    function erIsGetrokken() {
      return exists(/databases/$(database)/documents/trekking/huidig);
    }
    // Een lijstje is klaar bij minstens 3 cadeaus.
    function klaar(id) {
      return get(/databases/$(database)/documents/lijstjes/$(id)).data.items.size() >= 3;
    }
    function iedereenKlaar() {
      return klaar('janwillem') && klaar('gabrielle') && klaar('willemijn') && klaar('maarten') && klaar('jesse')
        && klaar('antoinette') && klaar('sara') && klaar('nine') && klaar('jelle') && klaar('janica');
    }

    // De trekking: iedereen leest (alles is versleuteld), alleen de organisator schrijft.
    match /trekking/{doc} {
      allow read: if true;
      allow write: if isOrganisator() && doc == 'huidig';
    }

    // Getrokken lootjes: één per persoon, alleen als iedereen minstens 3 cadeaus op zijn lijstje heeft,
    // en een getrokken lootje kan niet meer worden overschreven. Alleen de organisator kan wissen.
    match /deelnemers/{id} {
      allow read: if true;
      allow create: if isPersoon(id)
        && request.resource.data.keys().hasOnly(['wrapped','at'])
        && request.resource.data.wrapped is string && request.resource.data.wrapped.size() < 200
        && iedereenKlaar();
      allow delete: if isOrganisator();
    }

    // Wie heeft al gedraaid.
    match /onthuld/{id} {
      allow read: if true;
      allow create, update: if isPersoon(id) && erIsGetrokken()
        && request.resource.data.keys().hasOnly(['at']);
      allow delete: if isOrganisator();
    }

    // Verlanglijstjes.
    match /lijstjes/{id} {
      allow read: if true;
      allow write: if isPersoon(id)
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 60;
    }

    // "Ik koop dit".
    match /geclaimd/{id} {
      allow read: if true;
      allow write: if isPersoon(id)
        && request.resource.data.keys().hasOnly(['claims'])
        && request.resource.data.claims.size() <= 60;
    }
  }
}
